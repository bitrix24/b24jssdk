{
  // Semantics live in `tsconfig.base.json`; this file adds only what is specific
  // to this package. See `.github/contributing/testing.md`, "Where the compiler
  // flags live", for why the two are separate (#396).
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // The base sets `noEmit: true` and nothing here turns it back on: this
    // config drives `tsc --noEmit` only, and the shipped declarations come from
    // unbuild's own `declarationOptions` in `build.config.ts`.
    //
    // These two are kept anyway, because unbuild's declaration pass reads this
    // file: flipping either to `true` moves 30,640 lines of `dist`. Measured,
    // not assumed — `sourceMap` was here too and moved nothing, so it is gone,
    // as are `declaration`, `declarationMap`, `outDir: "./dist/types-temp"` and
    // `noEmit: false`, which `dist` proved dead in the same way (#396).
    "removeComments": false,
    "stripInternal": false
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "test",
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/*.stories.ts",
    "**/*.d.ts"
  ]
}
