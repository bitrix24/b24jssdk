{
  // Semantics live in `tsconfig.base.json`; this file adds only what is specific
  // to this package. See `.github/contributing/testing.md`, "Where the compiler
  // flags live", for why the two are separate (#396).
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // This config drives `tsc --noEmit` only. The shipped declarations come from
    // unbuild, which sets its own `declarationOptions` in `build.config.ts`.
    //
    // `declaration`, `declarationMap`, `outDir: "./dist/types-temp"` and
    // `noEmit: false` used to sit here and were removed in #396 after measuring
    // that they changed nothing: a full build with and without them produces a
    // byte-identical `dist`, and `dist/types-temp` has never been written.
    "sourceMap": true,
    "removeComments": false,
    "stripInternal": false
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "test",
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/*.stories.ts",
    "**/*.d.ts"
  ]
}
