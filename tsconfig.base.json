{
  "$schema": "https://json.schemastore.org/tsconfig",

  // The one place the repository's TypeScript *semantics* are written down:
  // language level, module resolution and the full strict-flag set. Four
  // configs extend it — `packages/jssdk`, `test/`, `playgrounds/cli` and
  // `skills/b24jssdk-recipes`.
  //
  // Why it exists (#396): `test/tsconfig.json` used to extend the *package
  // build* config, so a build-motivated edit there (`paths`, `moduleResolution`,
  // `lib`, `target`, whether declarations are emitted) silently changed what the
  // type-pin gate checks, with nothing to warn whoever made it. Meanwhile the
  // other two consumers had hand-copied subsets that had already drifted:
  // `playgrounds/cli` was missing `strictFunctionTypes`, `strictBindCallApply`,
  // `noImplicitOverride` and `noPropertyAccessFromIndexSignature`, and the
  // recipes config carried `strict` plus two `noUnused*` flags and nothing else.
  // `strict: true` does not imply any of them.
  //
  // Nothing about emitting belongs here. This config never emits (`noEmit` is
  // on); the one consumer that does emit turns it off and adds its own emit
  // settings. That is what lets `test/tsconfig.json` drop the `rootDir: ".."`
  // override it used to need purely because its parent emitted declarations.
  //
  // NOT covered, deliberately:
  // - `.{docs,jsdoc,skills,contributing}-typecheck/tsconfig.json` — generated by
  //   `scripts/*-typecheck*.mjs` to compile fragments extracted from markdown.
  //   They are `strict: false` on purpose; a strict base would be wrong there.
  // - `packages/jssdk-nuxt` and `docs` — both extend a Nuxt-generated
  //   `.nuxt/tsconfig.json`, which is their upstream and cannot be this one.
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "lib": ["ESNext", "DOM"],

    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,

    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "alwaysStrict": true,
    "noImplicitThis": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "exactOptionalPropertyTypes": false,
    "forceConsistentCasingInFileNames": true,

    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,

    "experimentalDecorators": false,
    "emitDecoratorMetadata": false,

    "useDefineForClassFields": true,
    "moduleDetection": "force",
    "incremental": false,

    "noEmit": true,

    "types": ["node"]
  }
}
