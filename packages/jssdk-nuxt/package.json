{
  "name": "@bitrix24/b24jssdk-nuxt",
  "version": "2.1.0",
  "author": "Bitrix",
  "license": "MIT",
  "description": "Bitrix24 REST API JS SDK for Nuxt",
  "keywords": [
    "bitrix24",
    "restapi",
    "nuxt"
  ],
  "homepage": "https://bitrix24.github.io/b24jssdk/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bitrix24/b24jssdk.git",
    "directory": "packages/jssdk-nuxt"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./runtime/*": "./dist/runtime/*"
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/module.d.mts"
      ],
      "runtime/*": [
        "./dist/runtime/*"
      ]
    }
  },
  "files": [
    "README.md",
    "LICENSE",
    "dist"
  ],
  "engines": {
    "node": "^20.0.0 || >=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare",
    "prepack": "pnpm build",
    "build": "nuxt-module-build build",
    "typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "@bitrix24/b24jssdk": "workspace:*",
    "@nuxt/kit": "^4.5.2"
  },
  "devDependencies": {
    "@nuxt/devtools": "^3.4.2",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.5.2",
    "@types/node": "^26.3.0",
    "nuxt": "^4.5.2",
    "typescript": "^6.0.3",
    "unbuild": "^3.6.1",
    "vue-tsc": "^3.3.11"
  }
}
