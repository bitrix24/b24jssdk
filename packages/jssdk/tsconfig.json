{
  // Semantics live in `tsconfig.base.json` at the repository root; this file
  // adds only what is specific to *building this package*. Before #396 the
  // strict-flag set lived here and `test/tsconfig.json` extended it, which made
  // every build-motivated edit here a silent change to the type-pin gate.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // `pnpm --filter ./packages/jssdk typecheck` is `tsc --noEmit`, and the
    // shipped declarations are emitted by unbuild (see `build.config.ts`,
    // which sets its own `declarationOptions`). These stay because they
    // describe the package's intent and unbuild reads this config for the
    // declaration pass.
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "removeComments": false,
    "stripInternal": false,

    "outDir": "./dist/types-temp",
    "noEmit": false
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "test",
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/*.stories.ts",
    "**/*.d.ts"
  ]
}
