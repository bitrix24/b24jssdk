{
  // Semantics live in `tsconfig.base.json`. This config used to extend
  // `packages/jssdk/tsconfig.json` — the package *build* config — which is what
  // #396 was about; see `.github/contributing/testing.md`, "What type-checks
  // what", for the reasoning and for why there is no `rootDir` override here
  // any more.
  //
  // Scope: **every** `.ts` under `test/`, not only the `*.types.spec.ts` pins.
  // It used to be the pins alone, and that left the rest of the tree compiled
  // by nobody — esbuild strips types without checking them. A spec could assert
  // against a shape the SDK does not have and only a live-portal run would ever
  // notice; #425 is the case that made this worth fixing (#428).
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // Relaxed for tests only, and deliberately: the flag forbids `obj.foo` when
    // `foo` comes from an index signature, and a test reaching into a portal
    // payload or a batch result keyed by command name does exactly that, on
    // purpose, ~218 times.
    "noPropertyAccessFromIndexSignature": false,
    "types": ["node", "vitest/globals"]
  },
  "include": ["./**/*.ts"],
  //
  // `test/integration/skills-recipes/*.spec.ts` imports the recipe files under
  // `skills/b24jssdk-recipes/`, so those — and their `grammy` / `node-cron` /
  // `openai` dependencies — are part of this program. Those deps live in a
  // non-workspace package the root `pnpm install` does not touch, which is why
  // `test:typecheck` and `package-jssdk:test:run-types` both run
  // `skills:install` first (#428).
  //
  // The two `test/integration/docs/**` specs import the docs Nuxt app, whose
  // modules need Nuxt's auto-imports and generated types. Those resolve under
  // `docs:typecheck` and cannot resolve here. Excluding a spec is a real gap,
  // not a tidy-up — if a third one appears, widen the pass rather than the
  // exclusion.
  "exclude": [
    "../node_modules",
    "./integration/docs/**"
  ]
}
